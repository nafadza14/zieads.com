# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META_ACCESS_TOKEN: Required for Meta Ads Library API
META_ACCESS_TOKEN=""

# TIKTOK_SCRAPER_API_TOKEN: Required for TikTok scraping (e.g., via Apify or RapidAPI)
TIKTOK_SCRAPER_API_TOKEN=""

# APIFY_API_TOKEN: Fallback for Apify
APIFY_API_TOKEN=""

# ─── Dodo Payments ────────────────────────────────────
DODO_PAYMENTS_SECRET_KEY=
VITE_DODO_PAYMENTS_PUBLISHABLE_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=

# Dodo Product IDs (from Dodo Payments Dashboard)
DODO_PRODUCT_STARTER_MONTHLY=
DODO_PRODUCT_STARTER_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_AGENCY_MONTHLY=
DODO_PRODUCT_AGENCY_YEARLY=
# ─── Competitor Hunt: live competitor ads and posts (docs/competitor-hunt-live-content.md) ───
# Free, official: Instagram Business Discovery through your own Instagram Business account
META_DISCOVERY_TOKEN=""
META_DISCOVERY_IG_ID=""
# Free, official: Meta Ad Library API (outside the EU it mostly returns political ads)
FACEBOOK_ACCESS_TOKEN=""
# Optional paid provider that covers every platform from the server
SCRAPECREATORS_API_KEY=""
# ZieAds Collector (runs on your own computer: npm run collector)
COLLECTOR_COUNTRY="ID"
COLLECTOR_HOURS="6"
COLLECTOR_HEADLESS="true"
# CHROME_PATH="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# ─── More networks (server/social) ───
# Threads: a Meta app with the Threads use case. Callback: {OAUTH_REDIRECT_BASE_URL}/api/auth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# Pinterest: developers.pinterest.com. Callback: /api/auth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# 1 while the Pinterest app has Trial access (Pins go to the sandbox), remove after Standard access
PINTEREST_SANDBOX=
# YouTube: Google Cloud OAuth client with YouTube Data API v3 enabled. Callback: /api/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Telegram: the shared ZieAds bot from @BotFather (users can also bring their own bot)
TELEGRAM_BOT_TOKEN=
# Bluesky, Mastodon and Discord need no keys.
# Discord one click connect: discord.com/developers, OAuth2, redirect {OAUTH_REDIRECT_BASE_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Sign in with Bluesky: optional ES256 private JWK (makes ZieAds a confidential client, longer sessions).
# Make one with: node -e "import('@atproto/oauth-client-node').then(async m=>console.log(JSON.stringify((await m.JoseKey.generate(['ES256'],'zieads-1')).privateJwk)))"
BLUESKY_OAUTH_PRIVATE_JWK=

# AI (Sumopod, OpenAI compatible). The key starts with sk-
SUMOPOD_API_KEY=
# Optional: model name. Default deepseek-v4-flash; ZieAds checks /v1/models and picks the closest match
SUMOPOD_MODEL=
