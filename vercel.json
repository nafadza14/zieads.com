{
  "functions": {
    "api/**": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/v3/publish/cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v3/jobs/run",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v3/cron/sync-instagram-comments",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/v3/monitor/tick",
      "schedule": "15 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/oauth/bluesky/(.*)",
      "destination": "/api"
    },
    {
      "source": "/features",
      "destination": "/features/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/data-deletion",
      "destination": "/data-deletion/index.html"
    },
    {
      "source": "/vs/metricool",
      "destination": "/vs/metricool/index.html"
    },
    {
      "source": "/vs/vista-social",
      "destination": "/vs/vista-social/index.html"
    },
    {
      "source": "/vs/hootsuite",
      "destination": "/vs/hootsuite/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/docs/quickstart",
      "destination": "/docs/quickstart/index.html"
    },
    {
      "source": "/docs/authentication",
      "destination": "/docs/authentication/index.html"
    },
    {
      "source": "/docs/limits",
      "destination": "/docs/limits/index.html"
    },
    {
      "source": "/docs/mcp",
      "destination": "/docs/mcp/index.html"
    },
    {
      "source": "/docs/mcp/claude",
      "destination": "/docs/mcp/claude/index.html"
    },
    {
      "source": "/docs/mcp/chatgpt",
      "destination": "/docs/mcp/chatgpt/index.html"
    },
    {
      "source": "/docs/mcp/cursor",
      "destination": "/docs/mcp/cursor/index.html"
    },
    {
      "source": "/docs/mcp/claude-code",
      "destination": "/docs/mcp/claude-code/index.html"
    },
    {
      "source": "/docs/mcp/vscode",
      "destination": "/docs/mcp/vscode/index.html"
    },
    {
      "source": "/docs/mcp/other-clients",
      "destination": "/docs/mcp/other-clients/index.html"
