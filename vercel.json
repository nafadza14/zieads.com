    },
    {
      "source": "/docs/api/health",
      "destination": "/docs/api/health/index.html"
    },
    {
      "source": "/docs/guides/automations",
      "destination": "/docs/guides/automations/index.html"
    },
    {
      "source": "/docs/faq",
      "destination": "/docs/faq/index.html"
    },
    {
      "source": "/docs/changelog",
      "destination": "/docs/changelog/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/analyst",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
